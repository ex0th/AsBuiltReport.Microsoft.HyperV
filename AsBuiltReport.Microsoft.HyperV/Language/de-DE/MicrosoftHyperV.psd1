    ModelNodeMajority = Knotenmehrheit
    ModelNodeAndWitnessMajority = Knoten- und Zeugenmehrheit
    ModelDiskOnly = Nur Datenträger (veraltet)
    WitnessNone = Keiner
    WitnessDisk = Datenträgerzeuge
